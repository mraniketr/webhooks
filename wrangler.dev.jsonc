{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-webhooks",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-hooklane-db",
      "database_id": "42bfc77c-4dbe-46fb-9708-4c63ae4f8c57"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "e1900d49f76c4329b87fc652261e4413"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "dev-hooklane-events" },
      { "binding": "EVENT_QUEUE", "queue": "dev-hooklane-events" },
      { "binding": "DELIVERY_SHARED", "queue": "dev-hooklane-deliveries-shared" },
      { "binding": "DELIVERY_PRO", "queue": "dev-hooklane-deliveries-pro" },
      { "binding": "ANALYTICS_QUEUE", "queue": "dev-hooklane-analytics" }
    ]
  },
  "ratelimits": [
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SESSION_TTL_MINUTES": "10",
    "TIER_CACHE_TTL_SECONDS": "30",
    "PLAN_CACHE_TTL_SECONDS": "15"
  }
}
