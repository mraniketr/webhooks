{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Note: reuses the `dev-webhooks-consumer-pro` worker name to replace it
  // in place (the OAuth token cannot delete workers).
  "name": "dev-webhooks-consumer-pro",
  "main": "src/delivery.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-hooklane-db",
      "database_id": "42bfc77c-4dbe-46fb-9708-4c63ae4f8c57"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "e1900d49f76c4329b87fc652261e4413"
    }
  ],
  // Dev delivery worker for the shared + pro tiers. Never attach
  // dev-hooklane-events or dev-hooklane-analytics here — router only.
  "queues": {
    "producers": [
      { "binding": "ANALYTICS_QUEUE", "queue": "dev-hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "dev-hooklane-deliveries-shared",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "dev-hooklane-deliveries-pro",
        "max_batch_size": 20,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
