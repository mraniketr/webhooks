{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks-router",
  "main": "src/router.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db",
      "database_id": "7d4b3e40-3ba2-4d52-84f5-fa24329102e0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "f0e6c89803434a74bb8216e2ecb99500"
    }
  ],
  // Router worker: the ONLY consumer of hooklane-events. Runs the pre-action,
  // fans out one task per subscription into the owner's tier delivery queue,
  // and owns the analytics queue writer. Delivery queues live in
  // wrangler.delivery.jsonc — never attach them here.
  "queues": {
    "producers": [
      { "binding": "DELIVERY_SHARED", "queue": "hooklane-deliveries-shared" },
      { "binding": "DELIVERY_PRO", "queue": "hooklane-deliveries-pro" },
      { "binding": "ANALYTICS_QUEUE", "queue": "hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "hooklane-events",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 8,
        "retry_delay": 10
      },
      {
        "queue": "hooklane-analytics",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
