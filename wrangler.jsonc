{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "hooklane-events" }
    ]
  },
  "ratelimits": [
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
