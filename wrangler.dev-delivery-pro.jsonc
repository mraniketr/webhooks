{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-webhooks-delivery-pro",
  "main": "src/delivery.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-hooklane-db",
      "database_id": "42bfc77c-4dbe-46fb-9708-4c63ae4f8c57"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "e1900d49f76c4329b87fc652261e4413"
    }
  ],
  // Dev pro-tier delivery worker. Same src/delivery.js artifact as the
  // shared worker — only the consumers[] list differs.
  "queues": {
    "producers": [
      { "binding": "ANALYTICS_QUEUE", "queue": "dev-hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "dev-hooklane-deliveries-pro",
        "max_batch_size": 20,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
