{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks-consumer",
  "main": "src/consumer.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db",
      "database_id": "7d4b3e40-3ba2-4d52-84f5-fa24329102e0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "f0e6c89803434a74bb8216e2ecb99500"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "hooklane-deliveries" },
      { "binding": "ANALYTICS_QUEUE", "queue": "hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "hooklane-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5
      },
      {
        "queue": "hooklane-deliveries",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5
      },
      {
        "queue": "hooklane-analytics",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 5
      }
    ]
  },
  "observability": { "enabled": true }
}
