{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-webhooks-consumer",
  "main": "src/consumer.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-hooklane-db",
      "database_id": "42bfc77c-4dbe-46fb-9708-4c63ae4f8c57"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "e1900d49f76c4329b87fc652261e4413"
    }
  ],
  // Shared-tier consumer (replaces the legacy single-queue dev consumer).
  // Owns dev-hooklane-events fan-out plus shared deliveries and analytics.
  // Legacy dev-hooklane-deliveries is left unconsumed for drain.
  "queues": {
    "producers": [
      { "binding": "DELIVERY_SHARED", "queue": "dev-hooklane-deliveries-shared" },
      { "binding": "DELIVERY_PRO", "queue": "dev-hooklane-deliveries-pro" },
      { "binding": "ANALYTICS_QUEUE", "queue": "dev-hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "dev-hooklane-events",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 8,
        "retry_delay": 10
      },
      {
        "queue": "dev-hooklane-deliveries-shared",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "dev-hooklane-analytics",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
