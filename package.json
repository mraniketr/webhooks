{
  "name": "hooklane-webhook-service",
  "version": "1.1.0",
  "private": true,
  "description": "Async webhook service for Cloudflare Workers, D1, Queues and Dynamic Workers",
  "scripts": {
    "dev": "wrangler dev",
    "dev:router": "wrangler dev --config wrangler.router.jsonc",
    "dev:delivery": "wrangler dev --config wrangler.delivery.jsonc",
    "deploy": "wrangler deploy",
    "deploy:router": "wrangler deploy --config wrangler.router.jsonc",
    "deploy:delivery": "wrangler deploy --config wrangler.delivery.jsonc",
    "deploy:all": "wrangler deploy && wrangler deploy --config wrangler.router.jsonc && wrangler deploy --config wrangler.delivery.jsonc",
    "deploy:dev": "wrangler deploy --config wrangler.dev.jsonc",
    "deploy:dev:router": "wrangler deploy --config wrangler.dev-router.jsonc",
    "deploy:dev:delivery": "wrangler deploy --config wrangler.dev-delivery.jsonc",
    "deploy:dev:all": "wrangler deploy --config wrangler.dev.jsonc && wrangler deploy --config wrangler.dev-router.jsonc && wrangler deploy --config wrangler.dev-delivery.jsonc",
    "provision:dedicated": "bash scripts/provision-dedicated.sh",
    "db:init": "wrangler d1 execute hooklane-db --remote --file=./db/schema.sql",
    "db:migrate:tiers": "wrangler d1 execute hooklane-db --remote --file=./db/migrate-tiered-plans.sql",
    "db:migrate:plans-v2": "wrangler d1 execute hooklane-db --remote --file=./db/migrate-plans-v2.sql",
    "db:migrate:plans-v2:dev": "wrangler d1 execute dev-hooklane-db --config wrangler.dev.jsonc --remote --file=./db/migrate-plans-v2.sql",
    "load:test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
