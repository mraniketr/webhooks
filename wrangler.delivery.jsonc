{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks-delivery",
  "main": "src/delivery.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db",
      "database_id": "7d4b3e40-3ba2-4d52-84f5-fa24329102e0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "f0e6c89803434a74bb8216e2ecb99500"
    }
  ],
  // Delivery worker for the shared + pro tiers (one deployment, per-queue
  // tuning below). Dedicated customers get their own deployment stamped from
  // wrangler.delivery-dedicated.template.jsonc. Never attach hooklane-events
  // or hooklane-analytics here — those belong to the router worker.
  "queues": {
    "producers": [
      { "binding": "ANALYTICS_QUEUE", "queue": "hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "hooklane-deliveries-shared",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "hooklane-deliveries-pro",
        "max_batch_size": 20,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
