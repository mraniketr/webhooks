{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks-consumer-pro",
  "main": "src/consumer.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db",
      "database_id": "7d4b3e40-3ba2-4d52-84f5-fa24329102e0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "f0e6c89803434a74bb8216e2ecb99500"
    }
  ],
  // Pro-tier delivery consumer. Same src/consumer.js artifact as shared —
  // only the consumers[] list differs. Higher batch size / tighter retry
  // delay than shared (per-tier tuning, see plan).
  "queues": {
    "producers": [
      { "binding": "ANALYTICS_QUEUE", "queue": "hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "hooklane-deliveries-pro",
        "max_batch_size": 20,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
