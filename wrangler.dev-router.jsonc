{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Note: reuses the legacy `dev-webhooks-consumer` worker name so the old
  // single-queue consumer is replaced in place (the OAuth token cannot
  // delete workers). Old dev-hooklane-deliveries is left unconsumed.
  "name": "dev-webhooks-consumer",
  "main": "src/router.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-hooklane-db",
      "database_id": "42bfc77c-4dbe-46fb-9708-4c63ae4f8c57"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "e1900d49f76c4329b87fc652261e4413"
    }
  ],
  // Dev router worker: the ONLY consumer of dev-hooklane-events, plus the
  // analytics queue. Delivery queues live in wrangler.dev-delivery.jsonc.
  "queues": {
    "producers": [
      { "binding": "DELIVERY_SHARED", "queue": "dev-hooklane-deliveries-shared" },
      { "binding": "DELIVERY_PRO", "queue": "dev-hooklane-deliveries-pro" },
      { "binding": "ANALYTICS_QUEUE", "queue": "dev-hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "dev-hooklane-events",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 8,
        "retry_delay": 10
      },
      {
        "queue": "dev-hooklane-analytics",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
