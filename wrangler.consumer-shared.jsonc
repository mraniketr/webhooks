{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webhooks-consumer-shared",
  "main": "src/consumer.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklane-db",
      "database_id": "7d4b3e40-3ba2-4d52-84f5-fa24329102e0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_CACHE",
      "id": "f0e6c89803434a74bb8216e2ecb99500"
    }
  ],
  // Shared-tier consumer. Owns hooklane-events fan-out (the ONLY events
  // consumer — do not attach the pro/dedicated workers to hooklane-events)
  // plus shared deliveries and analytics.
  // Legacy note: wrangler.consumer.jsonc (hooklane-deliveries) is kept for
  // drain only. After the old queue drains, delete it and this comment.
  "queues": {
    "producers": [
      { "binding": "DELIVERY_SHARED", "queue": "hooklane-deliveries-shared" },
      { "binding": "DELIVERY_PRO", "queue": "hooklane-deliveries-pro" },
      { "binding": "ANALYTICS_QUEUE", "queue": "hooklane-analytics" }
    ],
    "consumers": [
      {
        "queue": "hooklane-events",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 8,
        "retry_delay": 10
      },
      {
        "queue": "hooklane-deliveries-shared",
        "max_batch_size": 10,
        "max_batch_timeout": 0.1,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "hooklane-analytics",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
